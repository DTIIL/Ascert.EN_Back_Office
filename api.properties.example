# Copy this file to /etc/backoffice-application/api.properties
# or point -DAPI_CONFIG_PATH at your copy. Do not commit the real file.
# Grant the Tomcat user read access (chown and chmod 600).
spring.datasource.url=jdbc:postgresql://DB_HOST:5432/DB_NAME
spring.datasource.username=DB_USER
spring.datasource.password=DB_PASSWORD
